---
import ArticleBody from "~/components/blog/ArticleBody.astro"
import PageLayout from "~/layouts/PageLayout.astro"
import { getSitemapHeadings, getSitemapSections } from "~/utils/sitemap"

const sections = await getSitemapSections()
const headings = getSitemapHeadings(sections)
const metadata = {
  title: "Sitemap | Unique Divine",
  description:
    "Explore Unique Divine's projects, essays, categories, and tags.",
}
---

<PageLayout metadata={metadata}>
  <div
    class="sitemap-page mx-auto max-w-7xl px-4 sm:px-6 py-12 sm:py-16 xl:pr-[282px]"
  >
    <ArticleBody stickyToc headings={headings}>
      <header>
        <h1 class="text-4xl sm:text-5xl font-heading font-bold">Sitemap</h1>
        <p class="mt-4 text-base text-muted">
          Explore my projects, essays, and topics.
        </p>
      </header>
      {
        sections.map((section) => (
          <section
            class="sitemap-section"
            data-sitemap-section={section.id}
            aria-labelledby={`sitemap-${section.id}`}
          >
            <h2
              id={`sitemap-${section.id}`}
              class="text-xl font-heading font-semibold"
            >
              {section.title}
            </h2>
            {section.pages.length > 0 && (
              <ul class="sitemap-links">
                {section.pages.map((page) => (
                  <li>
                    <a
                      href={page.href}
                      data-sitemap-kind={
                        section.id === "resources" ? "resource" : "page"
                      }
                    >
                      {page.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
            {section.groups?.map((group) => (
              <div class="sitemap-group" data-sitemap-group={group.id}>
                <h3 id={group.id} class="text-lg font-heading font-semibold">
                  {group.href ? (
                    <a href={group.href} data-sitemap-kind="page">
                      {group.title}
                    </a>
                  ) : (
                    group.title
                  )}
                </h3>
                {group.pages.length > 0 && (
                  <ul class="sitemap-links">
                    {group.pages.map((page) => (
                      <li>
                        <a href={page.href} data-sitemap-kind="page">
                          {page.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </section>
        ))
      }
    </ArticleBody>
  </div>
</PageLayout>

<style>
  .sitemap-section {
    margin-top: 2.5rem;
  }
  .sitemap-group {
    margin-top: 1.5rem;
  }
  .sitemap-links {
    columns: 2 20rem;
    padding-left: 1.25rem;
    margin-top: 0.75rem;
    list-style: disc;
  }
  .sitemap-links li {
    break-inside: avoid;
    padding: 0.35rem 0;
    overflow-wrap: anywhere;
  }
  .sitemap-section a {
    color: var(--aw-color-primary, #2563eb);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  :global(.dark) .sitemap-section a {
    color: #67e8f9;
  }
  .sitemap-section a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }
</style>
