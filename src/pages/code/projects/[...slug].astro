---
import type { CollectionEntry } from "astro:content"

import Layout from "~/layouts/PageLayout.astro"
import { getProjects } from "~/utils/projects"

export async function getStaticPaths() {
  return (await getProjects()).map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }))
}

interface Props {
  project: CollectionEntry<"project">
}

const { project } = Astro.props
const { data } = project
const { Content } = await project.render()
const metadata = {
  title: data.title,
  description: data.summary,
  openGraph: { type: "article" },
}
---

<Layout metadata={metadata}>
  <article class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
    <a
      class="text-blue-600 dark:text-cyan-300 hover:underline"
      href="/code/projects">← All Projects</a
    >
    <header class="mt-8 mb-10">
      <p class="text-muted mb-3">{data.role}</p>
      <h1 class="text-4xl sm:text-5xl font-heading font-bold tracking-tight">
        {data.title}
      </h1>
      <p class="mt-5 text-xl text-muted">{data.summary}</p>
      <ul aria-label="Project Links" class="mt-6 flex flex-wrap gap-3">
        {
          data.links.map(({ label, href }) => (
            <li>
              <a
                class="inline-block rounded-full border border-slate-300 dark:border-slate-600 px-4 py-2 text-sm hover:text-blue-600 dark:hover:text-cyan-300 hover:border-current"
                href={href}
              >
                {label} <span aria-hidden="true">↗</span>
              </a>
            </li>
          ))
        }
      </ul>
    </header>
    <div
      class="prose prose-lg max-w-none dark:prose-invert prose-headings:font-heading prose-a:text-blue-600 dark:prose-a:text-cyan-300"
    >
      <Content />
    </div>
  </article>
</Layout>
