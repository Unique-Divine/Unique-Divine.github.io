---
import type { MarkdownHeading } from "astro"

import ArticleBody from "~/components/blog/ArticleBody.astro"
import Layout from "~/layouts/PageLayout.astro"
import type { MetaData } from "~/types"

export interface Props {
  frontmatter: {
    title?: string
    stickyToc?: boolean
  }
  headings?: MarkdownHeading[]
}

const { frontmatter, headings = [] } = Astro.props

const metadata: MetaData = {
  title: frontmatter?.title,
}
---

<Layout metadata={metadata}>
  <section
    class:list={[
      "px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20",
      frontmatter.stickyToc ? "max-w-3xl" : "max-w-4xl",
    ]}
  >
    <h1
      class="font-bold font-heading text-4xl md:text-5xl leading-tighter tracking-tighter"
    >
      {frontmatter.title}
    </h1>
    <div
      class="mx-auto prose prose-lg max-w-4xl dark:prose-invert dark:prose-headings:text-slate-300 prose-md prose-headings:font-heading prose-headings:leading-tighter prose-headings:tracking-tighter prose-headings:font-bold prose-a:text-blue-600 dark:prose-a:text-blue-400 prose-img:rounded-md prose-img:shadow-lg mt-8"
    >
      <ArticleBody stickyToc={frontmatter.stickyToc} headings={headings}>
        <slot />
      </ArticleBody>
    </div>
  </section>
</Layout>
