---
import type { ProjectReference } from "~/data/projectReferences"

import ProjectIcon from "./ProjectIcon.astro"

interface Props {
  project: ProjectReference
  detailed?: boolean
}

const { project, detailed = false } = Astro.props
const external = !project.href.startsWith("/")
---

<li
  class:list={[
    detailed
      ? "rounded-2xl border border-slate-200 bg-white/50 p-5 transition hover:border-slate-400 dark:border-slate-700 dark:bg-slate-800/30 dark:hover:border-slate-500"
      : "flex flex-wrap items-center gap-3",
  ]}
>
  <a
    href={project.href}
    class:list={[
      "group inline-flex items-center gap-3 focus-visible:outline-offset-4",
      detailed
        ? "text-lg font-semibold"
        : "rounded-xl border border-slate-200 bg-white/50 py-2 pl-2 pr-4 text-sm transition hover:border-slate-400 dark:border-slate-700 dark:bg-slate-800/30 dark:hover:border-slate-500",
    ]}
  >
    <ProjectIcon name={project.icon} />
    <span>{project.title}</span>
    <span aria-hidden="true" class="text-xs text-muted"
      >{external ? "↗" : "→"}</span
    >
  </a>
  {
    detailed && (
      <p class="mt-3 text-sm leading-relaxed text-muted">{project.summary}</p>
    )
  }
  {
    project.sourceHref && (
      <a
        href={project.sourceHref}
        aria-label={`${project.title} on GitHub`}
        class:list={[
          "text-sm underline underline-offset-4 hover:text-blue-600 dark:hover:text-cyan-300",
          detailed && "mt-4 inline-block",
        ]}
      >
        GitHub <span aria-hidden="true">↗</span>
      </a>
    )
  }
</li>
