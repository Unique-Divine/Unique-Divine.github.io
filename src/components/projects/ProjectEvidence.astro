---
import { getCollection } from "astro:content"

import {
  chainReference,
  earlierProjectReferences,
  type ProjectReference,
} from "~/data/projectReferences"
import { getProjects } from "~/utils/projects"

import ProjectReferenceItem from "./ProjectReferenceItem.astro"

interface Props {
  id?: string
  variant?: "compact" | "detailed"
}

const { id = "code-projects-title", variant = "compact" } = Astro.props
const detailed = variant === "detailed"
const projects = await getProjects()
const toReference = ({
  slug,
  data,
}: (typeof projects)[number]): ProjectReference => ({
  title: data.title,
  href: `/code/projects/${slug}`,
  summary: data.summary,
  icon: data.icon,
  sourceHref: data.links.find(
    ({ href }) => new URL(href).hostname === "github.com",
  )?.href,
})
const current = projects
  .filter(({ data }) => data.group === "current")
  .map(toReference)
if (detailed) current.push(chainReference)
const research = await getCollection(
  "post",
  ({ slug, data }) => slug.startsWith("code/projects/") && !data.draft,
)
research.sort((a, b) => a.data.title.localeCompare(b.data.title))
const earlier = [
  ...projects.filter(({ data }) => data.group === "earlier").map(toReference),
  ...research.map(
    ({ slug, data }): ProjectReference => ({
      title: data.title,
      href: `/${slug}`,
      summary: data.excerpt ?? "",
      icon: "code",
    }),
  ),
  ...earlierProjectReferences,
]
const earlierLinks = [
  ...new Map(earlier.map((project) => [project.href, project])).values(),
]
---

<section aria-labelledby={id} class="project-evidence not-prose my-12 sm:my-16">
  <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
    <span
      aria-hidden="true"
      class="h-2 w-2 rounded-full bg-amber-600 dark:bg-cyan-300"></span>
    <h2
      id={id}
      class="font-heading text-2xl sm:text-3xl font-bold tracking-tight"
    >
      What I've Built / Evidence
    </h2>
    <span
      aria-hidden="true"
      class="h-px flex-1 min-w-8 bg-slate-200 dark:bg-slate-700"></span>
  </div>
  <p class="mt-4 text-lg text-muted">
    Software I've built and maintained, and the research that came before it.
    The write-ups explain what went into the work.
  </p>
  <ul
    class:list={[
      "mt-6 gap-4",
      detailed ? "grid sm:grid-cols-2" : "flex flex-wrap",
    ]}
  >
    {
      current.map((project) => (
        <ProjectReferenceItem project={project} detailed={detailed} />
      ))
    }
  </ul>
  {
    earlierLinks.length > 0 && (
      <div class="mt-10">
        <h3 class="font-heading text-xl font-semibold">
          Research & Earlier Work
        </h3>
        <ul
          class:list={[
            "mt-4 gap-4",
            detailed ? "grid sm:grid-cols-2" : "flex flex-wrap",
          ]}
        >
          {earlierLinks.map((project) => (
            <ProjectReferenceItem project={project} detailed={detailed} />
          ))}
        </ul>
      </div>
    )
  }
  <a href="/code/projects" class="mt-6 inline-block text-sm hover:underline">
    All Project Stories <span aria-hidden="true">→</span>
  </a>
</section>
