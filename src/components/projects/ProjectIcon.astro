---
import { Icon } from "astro-icon/components"

import type { ProjectIconName } from "~/data/projectReferences"

interface Props {
  name?: ProjectIconName
}

const { name = "code" } = Astro.props

/** Official marks, drawn bare at tile size instead of inside a tile. */
const brandIcons: Partial<Record<ProjectIconName, string>> = {
  typescript: "devicon:typescript",
  rust: "devicon:rust",
  neovim: "devicon:neovim",
}

/** Generic topic icons, drawn inside a neutral tile. */
const topicIcons: Partial<Record<ProjectIconName, string>> = {
  code: "tabler:code",
  computer: "tabler:device-laptop",
  dna: "tabler:dna-2",
  school: "tabler:school",
  database: "tabler:database",
  notes: "tabler:notebook",
}

const brand = brandIcons[name]
---

{
  brand ? (
    <Icon
      name={brand}
      aria-hidden="true"
      class:list={[
        "h-8 w-8 shrink-0",
        // The Rust mark is monochrome; draw it in the text color.
        name === "rust" && "fill-current text-slate-900 dark:text-slate-100",
      ]}
    />
  ) : (
    <span
      aria-hidden="true"
      class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300"
    >
      {name === "nibiru" ? (
        <img
          src="/hero/nibiru-icon.png"
          width="24"
          height="24"
          alt=""
          loading="lazy"
          class="h-6 w-6 object-contain"
        />
      ) : (
        <Icon name={topicIcons[name] ?? "tabler:code"} class="h-5 w-5" />
      )}
    </span>
  )
}
