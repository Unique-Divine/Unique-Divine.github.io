---
import { Icon } from "astro-icon/components"

import type { ProjectIconName } from "~/data/projectReferences"

interface Props {
  name?: ProjectIconName
}

const { name = "code" } = Astro.props
const icons = {
  code: "tabler:code",
  rust: "tabler:brand-rust",
  computer: "tabler:device-laptop",
  dna: "tabler:dna-2",
  school: "tabler:school",
  database: "tabler:database",
  notes: "tabler:notebook",
}
---

<span
  aria-hidden="true"
  class:list={[
    "inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg font-mono text-sm leading-none",
    name === "typescript"
      ? "bg-blue-600 text-white"
      : name === "rust"
        ? "bg-orange-100 text-orange-900 dark:bg-orange-950 dark:text-orange-200"
        : "bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300",
  ]}
>
  {
    name === "nibiru" ? (
      <img
        src="/hero/nibiru-icon.png"
        width="24"
        height="24"
        alt=""
        loading="lazy"
        class="h-6 w-6 object-contain"
      />
    ) : name === "typescript" ? (
      "TS"
    ) : (
      <Icon name={icons[name]} class="h-5 w-5" />
    )
  }
</span>
