---
import GitHubActivity from "~/components/home/GitHubActivity"
import { getProjects } from "~/utils/projects"

import ProjectIcon from "./ProjectIcon.astro"

const projects = (await getProjects())
  .filter(({ data }) => data.featured && data.group === "current")
  .slice(0, 4)
---

{
  projects.length > 0 && (
    <section
      aria-labelledby="featured-projects-title"
      class="mx-auto max-w-screen-xl px-4 py-12 sm:px-6 md:py-16 lg:px-8"
    >
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h2
          id="featured-projects-title"
          class="font-heading text-3xl font-bold tracking-tight sm:text-4xl"
        >
          What I've Built
        </h2>
        <a
          class="font-medium text-blue-600 hover:underline dark:text-cyan-300"
          href="/code/projects"
        >
          All projects
        </a>
      </div>

      <div class="mt-6">
        <GitHubActivity client:visible />
      </div>

      <ul class="mt-8 grid divide-y divide-slate-200 dark:divide-slate-800 md:grid-cols-3 md:divide-x md:divide-y-0">
        {projects.map(({ slug, data }) => (
          <li class="py-6 first:pt-0 last:pb-0 md:px-8 md:py-1 md:first:pl-0 md:last:pr-0">
            <h3 class="font-heading text-xl font-bold leading-snug tracking-tight">
              <a
                class="group inline-flex items-start gap-3 hover:text-blue-600 focus-visible:underline dark:hover:text-cyan-300"
                href={`/code/projects/${slug}`}
              >
                <ProjectIcon name={data.icon} />
                <span class="pt-0.5 underline-offset-4 group-hover:underline">
                  {data.title}
                </span>
              </a>
            </h3>
            <p class="mt-3 text-muted">{data.tagline ?? data.summary}</p>
            <p class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-xs">
              {data.links.map(({ label, href }) => (
                <a
                  class="text-muted underline decoration-slate-400/50 underline-offset-4 hover:text-blue-600 dark:hover:text-cyan-300"
                  href={href}
                >
                  {label}
                </a>
              ))}
            </p>
          </li>
        ))}
      </ul>
    </section>
  )
}
