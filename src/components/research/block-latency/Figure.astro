---
import ExpandableDiagram from "~/components/common/ExpandableDiagram.astro"

import { ASSET_BASE, data } from "./model"

interface Props {
  file: keyof typeof data.figures
  alt: string
  badge: string
  view?: string
  eager?: boolean
}
const { file, alt, badge, view, eager = false } = Astro.props
const size = data.figures[file]
---

<div class="bl-figure" data-view={view}>
  <ExpandableDiagram
    src={`${ASSET_BASE}${file}`}
    alt={alt}
    width={size.width}
    height={size.height}
    loading={eager ? "eager" : "lazy"}
  >
    <span
      slot="caption"
      class:list={[
        "bl-badge",
        { "bl-hypothesis": badge.includes("Hypothetical") },
      ]}>{badge}</span
    >
  </ExpandableDiagram>
</div>
