---
import "@fontsource-variable/archivo"
import "@fontsource-variable/jetbrains-mono"
import "@fontsource-variable/geist"
import "@fontsource-variable/geist-mono"

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist

// Temporary font comparison: PUBLIC_FONT_VARIANT=geist swaps in Geist and
// Geist Mono, so two dev servers on one checkout differ only in fonts.
const fontVariant = import.meta.env.PUBLIC_FONT_VARIANT ?? "herdr"
---

<style is:inline is:global>
  /* JetBrains Mono (OFL-1.1) subset from herdr.dev via sai-web docs-app. Unlike
     the fontsource build, it includes the block and box-drawing glyphs the
     terminal mocks use (for example ▐▛███▜▌ and ├──). Characters it lacks fall
     back to the fontsource build listed next in --aw-font-mono. */
  @font-face {
    font-family: "JetBrains Mono Herdr";
    font-style: normal;
    font-weight: 400 700;
    font-display: swap;
    src: url("/fonts/jetbrains-mono-herdr.woff2") format("woff2");
  }

  :root {
    --aw-font-sans: "Geist Variable";
    --aw-font-serif: var(--aw-font-sans);
    /* Geist body, Archivo headings, JetBrains Mono for code. */
    --aw-font-heading: "Archivo Variable";
    --aw-font-mono: "JetBrains Mono Herdr", "JetBrains Mono Variable";

    --aw-color-primary: rgb(1 97 239);
    --aw-color-secondary: rgb(1 84 207);
    --aw-color-accent: rgb(109 40 217);

    --aw-color-text-heading: rgb(0 0 0);
    --aw-color-text-default: rgb(16 16 16);
    --aw-color-text-muted: rgb(16 16 16 / 66%);
    --aw-color-bg-page: rgb(255 255 255);

    /* midnight */
    --aw-color-bg-page-dark: #101720;

    ::selection {
      /* background-color: lavender; */
      background-color: white;
    }
  }

  .dark {
    /* Fonts come from :root; the dark theme changes colors only. */

    --aw-color-primary: rgb(1 97 239);
    --aw-color-secondary: rgb(1 84 207);
    --aw-color-accent: rgb(109 40 217);

    --aw-color-text-heading: rgb(0 0 0);
    --aw-color-text-default: rgb(229 236 246);
    --aw-color-text-muted: rgb(229 236 246 / 66%);
    --aw-color-bg-page: var(--aw-color-bg-page-dark);

    ::selection {
      background-color: black;
      color: snow;
    }
  }
</style>

{
  fontVariant === "geist" && (
    <style is:inline is:global>
      :root {
        --aw-font-sans: "Geist Variable";
        --aw-font-heading: "Geist Variable";
        --aw-font-mono: "Geist Mono Variable";
      }
    </style>
  )
}
