{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "moduleDetection": "force",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "types": ["bun"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "~/*": ["./src/*"],
      "@/*": ["./*"]
    }
  },
  "include": ["src", "scripts", "*.ts", ".astro/types.d.ts"],
  "exclude": ["node_modules", "dist", "services"]
}
